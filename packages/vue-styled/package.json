{
  "name": "@ai-accounts/vue-styled",
  "version": "0.3.13",
  "description": "Vue 3 styled components for ai-accounts",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/ai-accounts-vue-styled.cjs.js",
  "module": "./dist/ai-accounts-vue-styled.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ai-accounts-vue-styled.js",
      "require": "./dist/ai-accounts-vue-styled.cjs.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@ai-accounts/ts-core": "workspace:*",
    "@ai-accounts/vue-headless": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.2",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^15.0.0",
    "vite": "^5.4.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.1.0"
  },
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly --declaration",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "vue-tsc --noEmit -p tsconfig.test.json"
  }
}
